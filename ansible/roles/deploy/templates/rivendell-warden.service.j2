# Written by the dotfiles playbook. The code is the checkout's, so it changes
# with each deploy. Skipped until a deploy brings warden/warden.py in.
[Unit]
Description=rivendell-warden, Rivendell's update window
ConditionPathExists={{ deploy_repo }}/warden/warden.py

[Service]
Type=oneshot
User=deploy
EnvironmentFile={{ deploy_repo }}/rivendell.env
ExecStart=/usr/bin/python3 {{ deploy_repo }}/warden/warden.py tick
# Two reads of Plex 90 seconds apart, and git.
TimeoutStartSec=10min

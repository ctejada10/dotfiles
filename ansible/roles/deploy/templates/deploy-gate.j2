#!/bin/bash
# deploy-gate, written by the dotfiles playbook. The only thing GitHub
# Actions' key can run on {{ inventory_hostname }}: its authorized_keys line
# is restrict,command="/usr/local/bin/deploy-gate".
#
# It accepts one request, "deploy <full commit sha>", for a commit on
# {{ deploy_repo }}'s origin/{{ deploy_branch }}. It checks that commit out
# and runs that commit's own scripts/deploy.sh, which decrypts with this
# server's age key or reads 1Password with its own service account; no secret
# ever comes from GitHub. On this server, and never through the key,
# rivendell-warden also asks "apply <sha>", which runs deploy.sh --apply under
# the same lock and checkout. A deploy that has started
# finishes even if the client disconnects; the last one's output is in
# ~deploy/.local/state/deploy-gate/last-deploy.log.
#
# Before the requested commit's code runs, the checked-out commit's own
# scripts/deploy-hook, when it has one, vets the request ("vet <verb> <sha>",
# refused unless it exits 0, its output the reason), and hears of each refused
# request from GitHub ("refused <sha> <reason>", best effort), so the code that
# runs now judges what comes next.
#
# deploy.sh's exit status: 0 when it applied the commit, which stays checked
# out. 90 when it staged it and applied nothing, and 91 when it failed before
# changing anything: the gate checks the commit that was checked out before
# back out, so the checkout stays what the containers run, and answers 0 for
# 90 and 1 for 91. Any other status is a deploy that failed part-way, and the
# commit stays checked out. A gate stopped (TERM, INT or HUP) after its checkout
# for GitHub's request and before deploy.sh runs checks the commit before back
# out; once deploy.sh runs, the gate waits for its status.
#
# The request arrives in SSH_ORIGINAL_COMMAND under the restricted key, and as
# arguments when the workflow still connects with an older, unrestricted key
# and runs /usr/local/bin/deploy-gate itself, so a deploy works on either side
# of the key swap.

set -euo pipefail

repo={{ deploy_repo | quote }}
branch={{ deploy_branch | quote }}
# Forward only: a commit must be on the branch's own line (its first parents)
# and no older than the checked-out one, so the key can't bring back old code.
forward_only={{ deploy_forward_only | ternary('true', 'false') }}
lock=/run/lock/deploy-gate.lock

log() { logger -t deploy-gate -- "$*" 2>/dev/null || true; printf 'deploy-gate: %s\n' "$*" >&2; }
refuse() {
  log "refused: $*"
  # The warden reports its own refused applies, which never come through the key.
  if { [ -n "${SSH_ORIGINAL_COMMAND:-}" ] || [ "${verb:-}" != apply ]; } && [ -x "$repo/scripts/deploy-hook" ]; then
    local id=unknown
    [[ ${sha:-} =~ ^[0-9a-f]{40}$ ]] && id=$sha
    (cd "$repo" && timeout 30 ./scripts/deploy-hook refused "$id" "$*" 9>&-) \
      || log "could not report the refusal through scripts/deploy-hook"
  fi
  exit 1
}

request=${SSH_ORIGINAL_COMMAND:-$*}
request=${request#/usr/local/bin/deploy-gate }
# read takes the first line only, so a request with more is refused outright.
[[ $request != *$'\n'* ]] || refuse "only 'deploy <sha>' is accepted"
read -r verb sha extra <<< "$request" || true
mode=()
case ${verb:-} in
  deploy) ;;
  # The key's requests arrive in SSH_ORIGINAL_COMMAND, so GitHub can only stage.
  apply) [ -z "${SSH_ORIGINAL_COMMAND:-}" ] || refuse "only 'deploy <sha>' is accepted"; mode=(--apply) ;;
  *) refuse "only 'deploy <sha>' is accepted" ;;
esac
[ -z "${extra:-}" ] || refuse "only 'deploy <sha>' is accepted"
[[ "${sha:-}" =~ ^[0-9a-f]{40}$ ]] || refuse "the sha must be a full 40-character commit id"

# One deploy at a time; a second waits up to half an hour for the first. The
# warden's apply waits 10 seconds, then exits 75 and asks again next tick.
exec 9> "$lock"
if [ "$verb" = apply ]; then
  flock -w 10 9 || { log "another deploy is still running; ask again later"; exit 75; }
else
  flock -w 1800 9 || refuse "another deploy is still running"
fi

cd "$repo"
# A GitHub that doesn't answer fails the deploy rather than holding the lock.
timeout 300 git fetch --quiet origin "$branch" || refuse "couldn't fetch origin/$branch (exit $?)"
git merge-base --is-ancestor "$sha" "origin/$branch" || refuse "$sha is not on origin/$branch"
before=$(git rev-parse HEAD)
if [ "$forward_only" = true ]; then
  # Without -q grep reads to the end, so rev-list never dies of a closed pipe.
  git rev-list --first-parent "origin/$branch" | grep -xF "$sha" > /dev/null \
    || refuse "$sha is not on $branch's own line of commits, only on a branch merged into it"
  [ "$sha" = "$before" ] || ! git merge-base --is-ancestor "$sha" "$before" \
    || refuse "$sha is older than the checked-out $before"
fi
if [ -x scripts/deploy-hook ] && ! why=$(./scripts/deploy-hook vet "$verb" "$sha" 9>&-); then
  refuse "${why:-scripts/deploy-hook of the checked-out commit refused $sha}"
fi
# Checked in the commit, before the checkout: the running containers may read
# the checkout, so a refused request must leave it where it was.
[ "$(git ls-tree "$sha" scripts/deploy.sh | cut -d' ' -f1)" = 100755 ] \
  || refuse "$sha has no executable scripts/deploy.sh"
# GitHub's request stages the commit unless deploy.sh says otherwise, so a gate
# stopped before deploy.sh has run checks the commit before back out.
if [ "$verb" = deploy ]; then
  trap 'git checkout --quiet "$before"; log "stopped before deploy.sh ran; $before stays checked out"; exit 1' TERM INT HUP
fi
git checkout --quiet "$sha"

log "deploying $sha${mode:+ (${mode[*]})}"
# A deploy runs to the end even if the client goes away part-way: a run
# cancelled in GitHub, a lost runner, the job's timeout. Its output reaches the
# client through tee, which keeps writing it to deploy's log once the client's
# pipe breaks. Without tee the next write kills the deploy, and docker compose
# stopped mid-recreate leaves a container created and never started.
trap '' HUP
out=${XDG_STATE_HOME:-$HOME/.local/state}/deploy-gate
mkdir -p "$out"
rc=0
# From here deploy.sh's exit status decides what to do with the checkout. With
# a trap set, a stop sent to the gate waits for deploy.sh to end, and the gate
# then does what that status says.
if [ "$verb" = deploy ]; then
  trap : TERM INT
fi
# 9>&-: the lock stays the gate's own. A process deploy.sh leaves running, such
# as op's cache daemon, would otherwise hold it after the gate exits, and every
# later deploy would wait half an hour and be refused.
./scripts/deploy.sh "${mode[@]}" "$sha" 9>&- 2>&1 | tee -p "$out/last-deploy.log" 9>&- || rc=$?
case $rc in
  0) log "deployed $sha" ;;
  90)
    git checkout --quiet "$before"
    log "staged $sha; $before stays checked out"
    rc=0
    ;;
  91)
    git checkout --quiet "$before"
    log "deploy of $sha failed before changing anything; $before stays checked out"
    rc=1
    ;;
  *) log "deploy of $sha failed (exit $rc)" ;;
esac
exit "$rc"

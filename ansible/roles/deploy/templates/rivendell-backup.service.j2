# Written by the dotfiles playbook. The code is the checkout's, so it changes
# with each deploy. Skipped until a deploy brings scripts/backup.sh in. The
# script reports its own failures through hermes-relay.
[Unit]
Description=Rivendell's nightly backup of app_configs to B2
ConditionPathExists={{ deploy_repo }}/scripts/backup.sh
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
# restic reads every file in app_configs, whoever owns it. deploy gets no
# other right of root's.
AmbientCapabilities=CAP_DAC_READ_SEARCH
ExecStart=/bin/bash {{ deploy_repo }}/scripts/backup.sh backup
# The SQLite apps are stopped while restic reads. A run stopped at this limit
# starts them again on its way out.
TimeoutStartSec=4h

{{- $repos := dict -}}
{{- if .isAgent -}}
{{-   $repos = index .repos "agent-mini" -}}
{{- else if eq .role "laptop" -}}
{{-   $repos = .repos.laptop -}}
{{- end -}}
{{- if or .isAgent $repos -}}
#!/bin/bash
# Clones each repo into ~/src when it's missing, and never pulls.
# ~/src is a real folder on this Mac alone; work reaches the other Mac through
# GitHub.
{{- if .isAgent }}
# Agents work in these checkouts on their own branches, and a pull from here
# would land in the middle of their work. They clone over HTTPS, and gh's
# token authenticates.
{{- else }}
# The laptop's Git has no credential helper, so it clones over SSH: 1Password's
# agent holds the key and asks on this screen.
# ai-job-search takes its releases through Git, merged into the local commits
# that hold the profile, and cv is pulled by hand. Their personal files never
# leave this Mac through Git; personal-backup keeps an encrypted copy of them
# in Dropbox.
{{- end }}

set -uo pipefail
SCRIPT=clone-repos
{{ template "script-lib.sh" . }}

# ~/src used to be a link into Dropbox. A clone made through it would land in
# Dropbox and reach the other Mac, so nothing is cloned while it is one; the
# preflight says how to replace it.
if [ -L "$HOME/src" ]; then
  warn "the src folder in your home is still a link to $(readlink "$HOME/src"), so nothing was cloned"
  exit 0
fi
mkdir -p "$HOME/src"

# A clone that needs credentials gets them from the helper or fails. Git never
# asks at the terminal: GitHub takes no password there, and an attended apply
# would stop twice for every private repo.
export GIT_TERMINAL_PROMPT=0
{{- if .isAgent }}
github=https://github.com/
{{- else }}
github=git@github.com:
{{- end }}
gh_ok=1
{{- if .isAgent }}
# Without gh's login the private repos can't clone, and the public ones still
# do. Each clone is tried quietly and the ones that waited are named in one
# warning at the end, not one warning and one Git error per repo.
timeout_run 15 gh auth status >/dev/null 2>&1 || gh_ok=0
{{- end }}
waiting=""
{{- if eq .role "laptop" }}
cloned=""
{{- end }}

clone() {
  local dest="$HOME/src/$1"
  [ -e "$dest" ] && return 0
  if [ "$gh_ok" = 1 ]; then
    if git clone --quiet "$github$2.git" "$dest"; then
      say "cloned $2 into ~/src/$1"
{{- if eq .role "laptop" }}
      cloned="$cloned $1"
{{- end }}
    else
      warn "couldn't clone $2; the next apply tries again"
    fi
  elif git clone --quiet "$github$2.git" "$dest" 2>/dev/null; then
    say "cloned $2 into ~/src/$1"
{{- if eq .role "laptop" }}
    cloned="$cloned $1"
{{- end }}
  else
    waiting="$waiting $2"
  fi
}
{{  range $dir, $repo := $repos }}
clone {{ $dir | squote }} {{ $repo | squote }}
{{- end }}
if [ -n "$waiting" ]; then
  warn "gh isn't logged in, so these didn't clone:$waiting. Run gh auth login (HTTPS), then chezmoi apply."
fi
{{- if eq .role "laptop" }}

# ai-job-search holds a CV, salary expectations and application history, and
# its setup writes the profile into files Git tracks, kept as local commits.
# None of it may leave this Mac through Git, so its push URL goes nowhere and
# a pre-push hook refuses. Both are checked on every apply.
dest="$HOME/src/ai-job-search"
if [ -d "$dest/.git" ]; then
  if [ "$(git -C "$dest" remote get-url --push origin 2>/dev/null)" != no-push ]; then
    git -C "$dest" remote set-url --push origin no-push && say "turned off pushing from ~/src/ai-job-search"
  fi
  hook="$dest/.git/hooks/pre-push"
  if [ ! -x "$hook" ]; then
    printf '%s\n' '#!/bin/sh' 'echo "ai-job-search holds personal data and is never pushed." >&2' 'exit 1' > "$hook"
    chmod +x "$hook" && say "added a pre-push hook that refuses in ~/src/ai-job-search"
  fi
fi

# Personal files come back from the newest archive in Dropbox, once: for a
# repo in personal.yaml cloned just now, and for a data folder that isn't
# there yet. The restore asks 1Password for the personal age key. The data
# folders are made either way, so a restore that couldn't run isn't tried on
# every apply; the warning says how to run it by hand.
personal_repos={{ .personal.repos | join " " | squote }}
data_tools={{ .personal.data | join " " | squote }}
restore=""
for repo in $personal_repos; do
  case " $cloned " in *" $repo "*) restore="$restore $repo" ;; esac
done
for tool in $data_tools; do
  [ -e "$HOME/.local/share/$tool" ] || restore="$restore $tool"
done
if [ -n "$restore" ]; then
  # shellcheck disable=SC2086 # one word per name
  out=$("$HOME/.local/bin/personal-backup" restore $restore 2>&1)
  case $? in
    0) say "restored the personal files of$restore from Dropbox" ;;
    3) warn "no personal backup in Dropbox yet, so nothing was restored. Once Dropbox has synced backups/personal, run: personal-backup restore$restore" ;;
    4) warn "1Password didn't hand over the personal age key, so nothing was restored. Unlock 1Password with its CLI integration on, then run: personal-backup restore$restore" ;;
    *) warn "the restore of$restore didn't finish: $(printf '%s\n' "$out" | tail -n 1). See ~/Library/Logs/personal-backup/attention.txt" ;;
  esac
  for tool in $data_tools; do
    mkdir -p "$HOME/.local/share/$tool" && chmod 700 "$HOME/.local/share/$tool"
  done
fi

# ai-job-search's portal tools install their packages with Bun, once, after
# the first clone and after its restore, which refuses a clone that already
# has files of its own; `python3 tools/install_portal_clis.py` there does it
# again.
case " $cloned " in
  *" ai-job-search "*)
    if command -v bun >/dev/null 2>&1 && (cd "$HOME/src/ai-job-search" && python3 tools/install_portal_clis.py >/dev/null 2>&1); then
      say "installed ai-job-search's portal tools"
    else
      warn "couldn't install ai-job-search's portal tools; run python3 tools/install_portal_clis.py in ~/src/ai-job-search"
    fi
    ;;
esac
{{- end }}
exit 0
{{ end -}}

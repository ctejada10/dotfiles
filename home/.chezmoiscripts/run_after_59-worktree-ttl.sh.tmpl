{{- if .isAgent -}}
#!/bin/bash
# Keeps the worktree-ttl LaunchAgent loaded, and reloads it when its plist
# changes. Over SSH, with no one logged in at the mini, launchd has no GUI
# session to load it into; the next apply from the Mac's own session does.

set -uo pipefail
SCRIPT=worktree-ttl
{{ template "script-lib.sh" . }}

label=com.carlosetejada.worktree-ttl
plist="$HOME/Library/LaunchAgents/$label.plist"
marker="$HOME/Library/Logs/worktree-ttl/.loaded"
domain="gui/$(id -u)"

[ -f "$plist" ] || exit 0
if ! launchctl print "$domain" >/dev/null 2>&1; then
  warn "no login session to load the cleanup job into; the next apply at the mini's own session loads it"
  exit 0
fi
if launchctl print "$domain/$label" >/dev/null 2>&1; then
  [ -e "$marker" ] && [ ! "$plist" -nt "$marker" ] && exit 0
  launchctl bootout "$domain/$label" 2>/dev/null || true
  # Bootout returns before launchd has let go of a job that is running, and
  # bootstrap fails while the label is still loaded. launchd kills the job
  # 20 seconds after asking it to stop, so 30 seconds is enough.
  tries=0
  while launchctl print "$domain/$label" >/dev/null 2>&1 && [ "$tries" -lt 30 ]; do
    sleep 1
    tries=$((tries + 1))
  done
fi
if launchctl bootstrap "$domain" "$plist"; then
  mkdir -p "$(dirname "$marker")" && touch "$marker"
  say "loaded the worktree cleanup job (daily at 04:17)"
else
  warn "couldn't load $plist, so the worktree cleanup job is not loaded and nothing is cleaned until the next apply, which tries again"
fi
exit 0
{{ end -}}

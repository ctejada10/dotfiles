{{- if eq .role "laptop" -}}
{{- $repos := index .repos "agent-mini" -}}
#!/bin/bash
# The laptop's read-only guard for the mini's repos works through
# core.hooksPath in ~/.gitconfig. A repo that sets core.hooksPath in its own
# .git/config wins over it, so the guard's hook never runs there. This only
# reads and warns; the fix belongs on the mini, which owns those repos.

set -uo pipefail
SCRIPT=check-agent-repos
{{ template "script-lib.sh" . }}

export GIT_OPTIONAL_LOCKS=0
{{- range $dir, $_ := $repos }}
repo={{ joinPath $.dropboxRepositories $dir | squote }}
if [ -d "$repo/.git" ]; then
  for file in "$repo/.git/config" "$repo/.git/config.worktree"; do
    [ -f "$file" ] || continue
    if value=$(git config --includes --file "$file" --get core.hooksPath 2>/dev/null); then
      warn "{{ $dir }} sets core.hooksPath to $value in $(basename "$file"), so the read-only guard doesn't run there. On the mini, unset it, or move it into the mini's ~/.gitconfig if the repo needs those hooks."
    fi
  done
fi
{{- end }}
exit 0
{{ end -}}

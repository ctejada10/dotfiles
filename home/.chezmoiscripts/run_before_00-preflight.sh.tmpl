{{- if and .isMac (not .ci) -}}
#!/bin/bash
# Stops the apply while the old tilde still runs this home folder. Its stow
# links point into the Dropbox checkout, and the cutover is the one moment
# they should be replaced. Run the cutover apply with DOTFILES_CUTOVER=1.
# ~/.ssh must be a real folder first, so nothing is written through the old
# link into Dropbox, and so must ~/src, where the repos are cloned. On the
# laptop ~/.config becomes a link into Dropbox; chezmoi would delete a real
# folder in its place without asking, so this moves what's in it into Dropbox
# and makes the link first.

set -uo pipefail
SCRIPT=preflight
{{ template "script-lib.sh" . }}

status=0

if [ -L "$HOME/.ssh" ]; then
  warn "the .ssh folder in your home is still a link to $(readlink "$HOME/.ssh"). Make it a real folder first (see the README's cutover steps)."
  status=1
fi

old=()
for target in .zshrc .zsh .gitconfig .gitignore_global .tmux.conf .condarc \
              .claude/settings.json .claude/CLAUDE.md .claude/hooks; do
  link="$HOME/$target"
  if [ -L "$link" ]; then
    case "$(readlink "$link")" in
      *[Rr]epositories/tilde/*) old+=("$target") ;;
    esac
  fi
done
if [ ${#old[@]} -gt 0 ] && [ "${DOTFILES_CUTOVER:-}" != 1 ]; then
  warn "the old tilde still owns ${old[*]}."
  warn "this apply would replace them. If this is the cutover, run: DOTFILES_CUTOVER=1 chezmoi apply"
  status=1
fi

# ~/src used to link into Dropbox's repositories folder. Now the repos are
# cloned into a real ~/src, and a clone made through the old link would land in
# Dropbox and reach the other Mac.
if [ -L "$HOME/src" ]; then
  warn "the src folder in your home is still a link to $(readlink "$HOME/src"), and the repos are now cloned into a real ~/src."
  warn "remove just the link, never what it points to, then apply again: unlink ~/src && chezmoi apply"
  status=1
fi

{{- if eq .role "laptop" }}

# A real ~/.config where the link into Dropbox's config-files goes, but only
# once config-files exists: until then the link is held back, and init has
# written chezmoi's config into a real folder. Its contents move into
# config-files and the link is made here, before chezmoi would delete the
# folder. Dropbox is on the same disk, so the moves are renames, and chezmoi's
# state file, open through this apply, moves with its folder.
dropbox={{ .dropboxConfig | squote }}
folder="$HOME/.config"
only_socket() {
  local entry
  for entry in "$1"/* "$1"/.[!.]*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    [ "${entry##*/}" = op-daemon.sock ] || return 1
  done
}
# The Trash, not rm: a copy config-files already has may still be wanted.
# macOS's own trash command, which needs no access to look inside the Trash.
to_trash() { trash "$1"; }
if [ -d "$dropbox" ] && [ -d "$folder" ] && [ ! -L "$folder" ]; then
  failed=0
  for entry in "$folder"/* "$folder"/.[!.]*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    base=${entry##*/}
    if [ "$base" = chezmoi ]; then
      # This install's config and state win over an earlier install's, whose
      # state would stop setup scripts from running again.
      { [ ! -e "$dropbox/chezmoi" ] || to_trash "$dropbox/chezmoi"; } && mv "$entry" "$dropbox/" || failed=1
    elif [ "$base" = op ] && only_socket "$entry"; then
      # 1Password's CLI makes its folder the first time it runs, so the
      # apply's own 1Password check leaves one holding only op's socket.
      rm -r "$entry" || failed=1
    elif [ -e "$dropbox/$base" ]; then
      # config-files has the synced copy; this one a tool wrote on this
      # install, such as gh's after logging in.
      to_trash "$entry" && say "moved the new $base settings to the Trash; the ones in Dropbox stay" || failed=1
    else
      mv "$entry" "$dropbox/" && say "moved the $base settings into Dropbox" || failed=1
    fi
  done
  if [ "$failed" = 0 ] && rmdir "$folder" && ln -s "$dropbox" "$folder"; then
    say "linked $folder to $dropbox"
  else
    warn "couldn't empty $folder into $dropbox (see above), and this apply would replace it with a link."
    warn "move what's left in it into $dropbox, then: rmdir $folder && ln -s $dropbox $folder && chezmoi apply"
    status=1
  fi
fi
{{- end }}

exit "$status"
{{ end -}}

{{- if and .isAgent (not .ci) -}}
#!/bin/bash
# Adopts the Hermes already on the mini. Never installs or updates it, and only
# writes what differs, so a run with nothing to do changes nothing. Sessions,
# state.db, memories, approvals and cron jobs are never touched.

set -uo pipefail
SCRIPT=hermes
{{ template "script-lib.sh" . }}

hermes=$HOME/.local/bin/hermes
data=$HOME/.local/share/dotfiles/hermes
state=$HOME/.local/state/dotfiles/hermes
sync=$HOME/.local/bin/hermes-config-sync
pin={{ .hermes.version | squote }}
changed=

have=$("$hermes" --version 2>/dev/null | sed -n 's/^Hermes Agent v\([0-9.]*\).*/\1/p')
if [ -z "$have" ]; then
  warn "Hermes isn't installed, and tilde never installs it. Nothing in ~/.hermes was touched. See section 8 of docs/setup-mini.md."
  exit 1
fi
if [ "$have" != "$pin" ]; then
  warn "Hermes is $have but tilde pins $pin. Nothing in ~/.hermes was touched. After an upgrade, change hermes.version in home/.chezmoidata/hermes.yaml."
  exit 1
fi

( umask 077; mkdir -p "$state" )

# The first run only: a copy of what tilde is about to change.
if [ ! -e "$state/backed-up" ]; then
  backup=$state/backup-$(date +%Y%m%d-%H%M%S)
  ( umask 077; mkdir -p "$backup" )
  cp -p "$HOME/.hermes/config.yaml" "$backup/" || { warn "couldn't back up config.yaml, so nothing was changed"; exit 1; }
  cp -p "$HOME/.hermes/.env" "$backup/" 2>/dev/null
  cp -pR "$HOME/.hermes/skills" "$backup/" || { warn "couldn't back up the skills, so nothing was changed"; exit 1; }
  touch "$state/backed-up"
  say "backed up Hermes's config to $backup"
fi

{{ if .hermes.secrets.enabled -}}
# render TARGET: op inject of the template on stdin into a private temporary
# file, then the marked block in TARGET. Values go through files, never the log.
render() {
  local tmp out
  tmp=$(mktemp "$state/render.XXXXXX") || return 1
  if timeout_run 60 op inject --force -o "$tmp" >/dev/null 2>&1; then
    out=$("$sync" env "$tmp" "$1") && [ -z "$out" ] || changed=1
  else
    warn "op inject couldn't render, so $1 was left as it was"
  fi
  rm -f "$tmp"
}
OP_SERVICE_ACCOUNT_TOKEN=$(security find-generic-password -a "$USER" -s hermes-op-service-account -w 2>/dev/null) || OP_SERVICE_ACCOUNT_TOKEN=
export OP_SERVICE_ACCOUNT_TOKEN
if [ -n "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
  render "$HOME/.hermes/.env" <<'TEMPLATE'
{{ template "hermes-secrets.op" . }}
TEMPLATE
{{- if .hermes.hurin.enabled }}
  render "$state/bridge.env" <<'TEMPLATE'
{{ template "hermes-bridge.op" . }}
TEMPLATE
{{- end }}
else
  warn "no service account token in the keychain, so no secrets were rendered"
fi
unset OP_SERVICE_ACCOUNT_TOKEN
{{ end -}}

out=$("$sync" config "$data/config.json" "$state/applied.json") || { warn "couldn't update Hermes's config"; exit 1; }
if [ -n "$out" ]; then
  while IFS= read -r line; do say "hermes config: $line"; done <<<"$out"
  changed=1
fi

{{ if .hermes.hurin.enabled -}}
mkdir -p "$HOME/.hermes/skills/hurin/events"
if ! cmp -s "$data/SKILL.md" "$HOME/.hermes/skills/hurin/events/SKILL.md"; then
  cp "$data/SKILL.md" "$HOME/.hermes/skills/hurin/events/SKILL.md" && say "updated the hurin skill" && changed=1
fi
if [ -n {{ .hermes.hurin.bridge.tag | squote }} ]; then
  bridge_pin=$state/bridge-tag
  if [ "$(cat "$bridge_pin" 2>/dev/null)" != {{ .hermes.hurin.bridge.tag | squote }} ]; then
    uv tool install --force "git+https://github.com/ctejada10/hurin@{{ .hermes.hurin.bridge.tag }}" \
      && printf '%s\n' {{ .hermes.hurin.bridge.tag | squote }} >"$bridge_pin" \
      || warn "couldn't install the bridge at {{ .hermes.hurin.bridge.tag }}"
  fi
fi
{{ end -}}

if [ -n "$changed" ]; then
  if launchctl print "gui/$(id -u)/ai.hermes.gateway" >/dev/null 2>&1; then
    "$hermes" gateway restart >/dev/null 2>&1 && say "restarted the Hermes gateway" || warn "couldn't restart the Hermes gateway"
  else
    warn "the Hermes gateway isn't loaded, so the changes wait for it to start"
  fi
fi

# Always on. Only what differs reaches pmset.
power=$(pmset -g 2>/dev/null)
for pair in sleep=0 disksleep=0 womp=1 autorestart=1 powernap=0; do
  key=${pair%=*} value=${pair#*=}
  if ! grep -Eq "^ *$key +$value\$" <<<"$power"; then
    if can_root; then
      as_root pmset -a "$key" "$value" && say "set pmset $key to $value"
    else
      warn "pmset $key should be $value; the next apply with sudo sets it"
    fi
  fi
done

# Only the steps still undone. Steps nothing can detect stay until the file
# named beside them exists.
todo() { [ -e "$state/done-$1" ] || printf '  - %s (then: touch %s)\n' "$2" "$state/done-$1"; }
{
{{- if .hermes.secrets.enabled }}
  security find-generic-password -a "$USER" -s hermes-op-service-account >/dev/null 2>&1 \
    || echo "  - Store the service account token: security add-generic-password -a \"\$USER\" -s hermes-op-service-account -w"
{{- else }}
  echo "  - Create the Hermes vault items in .chezmoitemplates/hermes-secrets.op, store the service account token, then set hermes.secrets.enabled"
{{- end }}
{{- if .hermes.hurin.enabled }}
  todo fda "Grant Full Disk Access to the bridge binary only"
  todo messages "Turn on Messages in iCloud here, and Text Message Forwarding to this Mac on the iPhone"
  ls -d /Applications/Beeper*.app >/dev/null 2>&1 || echo "  - Install Beeper Desktop, sign in, and enable its local API with read-only access"
  todo beeper "Confirm Beeper Desktop's local API is on and read-only"
  todo tailscale "Log in to Tailscale and tag this Mac tag:agent (the ACL grants are in the Hurin repo)"
  todo approvals "Confirm in a Hermes chat that the five pre-approved hurin_act tools run without a prompt and any other act tool prompts"
{{- end }}
} >"$state/checklist"
if [ -s "$state/checklist" ]; then
  say "still to do by hand:"
  cat "$state/checklist"
fi
exit 0
{{ end -}}

#!/usr/bin/python3
"""Keeps Hermes in line with tilde without touching anything else.

  hermes-config-sync config DESIRED.json STATE.json
      Sets each key in DESIRED that differs, through `hermes config set`, so
      the comments in config.yaml survive. Prints the name of each key changed
      and any allowlist entry removed.
  hermes-config-sync env RENDERED FILE
      Puts RENDERED in a marked block in FILE, mode 600, leaving other lines
      alone. Prints "changed" if the file changed. Never prints a value.
"""
import hashlib
import json
import os
import stat
import subprocess
import sys

HERMES = os.path.expanduser(os.environ.get("HERMES_BIN", "~/.local/bin/hermes"))
BEGIN = "# >>> tilde: rendered from 1Password, do not edit >>>"
END = "# <<< tilde <<<"


def hermes(*args):
    run = subprocess.run([HERMES, "config", *args], capture_output=True, text=True)
    if run.returncode:
        raise SystemExit(f"hermes config {args[0]} {args[1]} failed")
    return run.stdout.strip()


def current(key):
    """The key's value as text or a list, or None if it isn't set."""
    run = subprocess.run([HERMES, "config", "get", key], capture_output=True, text=True)
    if "Config key not set" in run.stdout + run.stderr:
        return None
    if run.returncode:
        raise SystemExit(f"hermes config get {key} failed")
    out = run.stdout.strip()
    if out == "[]":
        return []
    lines = out.splitlines()
    if lines and all(line.strip().startswith("- ") for line in lines):
        return [line.strip()[2:].strip("'\"") for line in lines]
    return out


def digest(text):
    return hashlib.sha256(text.encode()).hexdigest()


def wanted(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    return value if isinstance(value, list) else str(value)


def sync_config(desired_path, state_path):
    with open(desired_path) as f:
        desired = json.load(f)
    try:
        with open(state_path) as f:
            state = json.load(f)
    except FileNotFoundError:
        state = {}
    before = dict(state)
    try:
        for key, value in desired.items():
            if isinstance(value, dict):
                # A map can't be compared with what Hermes prints, so remember
                # what it printed after the last set and repair any drift.
                sent = digest(json.dumps(value, sort_keys=True))
                if state.get(key) == [sent, digest(str(current(key)))]:
                    continue
            else:
                have = current(key)
                if have == wanted(value) or (have is None and value == []):
                    continue
                if key == "command_allowlist":
                    for entry in sorted(set(have or []) - set(value)):
                        print(f"removed from command_allowlist: {entry}")
            hermes("set", key, json.dumps(value) if isinstance(value, (list, dict)) else wanted(value))
            print(key)
            if isinstance(value, dict):
                state[key] = [sent, digest(str(current(key)))]
    finally:
        if state != before:
            with open(state_path, "w") as f:
                json.dump(state, f, indent=2)


def sync_env(rendered_path, env_path):
    with open(rendered_path) as f:
        block = [line for line in f.read().splitlines() if line and not line.startswith("#")]
    keys = {line.split("=", 1)[0] for line in block}
    try:
        with open(env_path) as f:
            old = f.read()
    except FileNotFoundError:
        old = ""
    kept, inside = [], False
    for line in old.splitlines():
        if line == BEGIN:
            inside = True
        elif line == END:
            inside = False
        elif not inside and line.split("=", 1)[0] not in keys:
            kept.append(line)
    new = "\n".join(kept + [BEGIN, *block, END]) + "\n"
    if new == old:
        if stat.S_IMODE(os.stat(env_path).st_mode) != 0o600:
            os.chmod(env_path, 0o600)
        return
    tmp = env_path + ".tilde"
    if os.path.exists(tmp):
        os.unlink(tmp)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(new)
    os.replace(tmp, env_path)
    print("changed")


if __name__ == "__main__":
    {"config": sync_config, "env": sync_env}[sys.argv[1]](sys.argv[2], sys.argv[3])

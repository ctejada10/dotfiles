###############################################################################
# device                                                                      #
###############################################################################

# Python with PyYAML: the playbook's own environment.
py() {
  local python=${DOTFILES_PYTHON:-$REPO/ansible/.venv/bin/python}
  if [ ! -x "$python" ]; then
    (cd "$REPO/ansible" && uv sync --locked --quiet) || { warn "couldn't set up the playbook's Python (cd $REPO/ansible && uv sync)"; return 1; }
  fi
  "$python" -I "$@"
}

# A device change that hasn't merged yet. Every device command starts from
# GitHub's copy of keys.yaml, so one run before the last one's PR merges would
# put back the keys that change took away.
pending_change() {
  local open
  if ! open=$(cd "$REPO" && timeout_run 30 gh pr list --state open --json headRefName,url \
      --jq '.[] | select(.headRefName | startswith("device-")) | .url' 2>/dev/null); then
    warn "couldn't ask GitHub for open device PRs, so nothing changed"
    return 0
  fi
  if [ -n "$open" ]; then
    warn "a device change hasn't merged yet: $open. Merge it, or close it to drop it, then run this again. Nothing changed"
    return 0
  fi
  return 1
}

# The keys.yaml everything starts from: GitHub's, so a change builds on the
# latest record, not on whatever this checkout last pulled.
fetch_keys() {
  git -C "$REPO" fetch --quiet origin || { warn "couldn't fetch the repo from GitHub"; return 1; }
  git -C "$REPO" show "$(git -C "$REPO" rev-parse --abbrev-ref origin/HEAD):home/.chezmoidata/keys.yaml" > "$tmp/keys.yaml"
}

# keys_py <keys.yaml> <show|set|remove> [name] [key]. show prints the devices
# and retired keys as JSON. set and remove write the new keys.yaml to keys.new
# and the device keys and retired keys after the change to keys.json. Edits
# the text line by line, so comments stay, then checks the result parses to
# exactly the intended data. Writes nothing else, so it runs before any yes.
keys_py() {
  py - "$@" <<'PY'
import json, re, sys, yaml
path, action = sys.argv[1], sys.argv[2]
name = sys.argv[3] if len(sys.argv) > 3 else ""
key = sys.argv[4] if len(sys.argv) > 4 else ""
FORM = ("keys.yaml's devices or retiredLogin isn't in the form this edits, each entry "
        "on a line of its own and indented four spaces; put it so, then run this again")
text = open(path).read()
try:
    data = yaml.safe_load(text)["ssh"]
except (yaml.YAMLError, KeyError, TypeError):
    sys.exit("keys.yaml doesn't read as YAML with an ssh section")
devices = dict(data.get("devices") or {})
retired = list(data.get("retiredLogin") or [])
if action == "show":
    print(json.dumps({"devices": devices, "retired": retired}))
    sys.exit(0)
if name and yaml.safe_load(f"{name}: x") != {name: "x"}:
    sys.exit(f"{name} reads as something other than a name in YAML; pick another")
lines = text.split("\n")

def find(prefix):
    for i, line in enumerate(lines):
        if line == prefix or line.startswith(prefix + " "):
            return i
    sys.exit(f"keys.yaml has no line '{prefix}'")

def block_end(start):
    # The first line after start that isn't one of its entries or a comment inside it.
    j = start + 1
    while j < len(lines) and (lines[j].startswith("    ") or lines[j].strip() == ""):
        j += 1
    while j > start + 1 and lines[j - 1].strip() == "":
        j -= 1
    return j

def open_block(i, field, empty):
    # "  devices: {}" and "  retiredLogin: []" become a block entries can go under.
    rest = lines[i].split(":", 1)[1].strip()
    if rest == empty:
        lines[i] = f"  {field}:"
    elif rest:
        sys.exit(FORM)

old = devices.get(name, "") or ""
d = find("  devices:")
if action == "set":
    open_block(d, "devices", "{}")
    entry = f'    {name}: "{key}"'
    for i in range(d + 1, block_end(d)):
        if re.match(rf"    {re.escape(name)}:", lines[i]):
            lines[i] = entry
            break
    else:
        lines.insert(block_end(d), entry)
    devices[name] = key
elif action == "remove":
    if name not in devices:
        sys.exit(f"keys.yaml lists no device called {name}")
    for i in range(d + 1, block_end(d)):
        if re.match(rf"    {re.escape(name)}:", lines[i]):
            del lines[i]
            break
    else:
        sys.exit(FORM)
    del devices[name]
    # A block with nothing under it would read as null.
    if not devices and block_end(d) == d + 1:
        lines[d] = "  devices: {}"

if old:
    r = find("  retiredLogin:")
    open_block(r, "retiredLogin", "[]")
    lines.insert(block_end(r), f'    - "{old}"')
    retired.append(old)

new = "\n".join(lines)
try:
    check = yaml.safe_load(new)["ssh"]
except (yaml.YAMLError, KeyError, TypeError):
    sys.exit(FORM)
if dict(check.get("devices") or {}) != devices or list(check.get("retiredLogin") or []) != retired:
    sys.exit(FORM)
open(path.replace("keys.yaml", "keys.new"), "w").write(new)
json.dump({"device_keys": devices, "retired_login_keys": retired}, open(path.replace("keys.yaml", "keys.json"), "w"))
PY
}

fingerprint() { ssh-keygen -l -f - <<< "$1" 2>/dev/null | awk '{print $2, $NF}'; }
body_of() { awk '{for (i = 1; i <= NF; i++) if ($i ~ /^AAAA/) { print $i; exit }}' <<< "$1"; }

# The key a device logs in with: its public half, one line, a type sshd takes
# from a user's authorized_keys, and never a certificate.
check_key() {
  local key=$1 bits type
  [ "$(wc -l <<< "$key" | tr -d ' ')" = 1 ] || { warn "that's more than one line; paste one public key"; return 1; }
  type=${key%% *}
  case "$type" in
    ssh-ed25519 | ssh-rsa | ecdsa-sha2-nistp256 | ecdsa-sha2-nistp384 | ecdsa-sha2-nistp521 \
      | sk-ssh-ed25519@openssh.com | sk-ecdsa-sha2-nistp256@openssh.com) ;;
    *-cert-v01@openssh.com) warn "that's a certificate, not a public key; copy the key itself"; return 1 ;;
    *) warn "\"$type\" isn't a public key type a device logs in with; copy the whole public key"; return 1 ;;
  esac
  bits=$(ssh-keygen -l -f - <<< "$key" 2>/dev/null | awk '{print $1}')
  [ -n "$bits" ] || { warn "that isn't a whole public key (cut short?); copy it again"; return 1; }
  if [ "$type" = ssh-rsa ] && [ "$bits" -lt 3072 ]; then
    warn "an RSA key of $bits bits is too weak; make one of 3072 bits or more, or an Ed25519 or ECDSA key"
    return 1
  fi
}

device_list() {
  fetch_keys || return 1
  keys_py "$tmp/keys.yaml" show > "$tmp/show.json" || return 1
  py - "$tmp/show.json" <<'PY'
import json, subprocess, sys
d = json.load(open(sys.argv[1]))
def fp(k):
    out = subprocess.run(["ssh-keygen", "-l", "-f", "-"], input=k, capture_output=True, text=True).stdout.split()
    return f"{out[1]} {out[-1]}" if out else "(not a whole key)"
print("Devices, as GitHub's copy of keys.yaml has them:")
for name, key in sorted(d["devices"].items()):
    print(f"  {name:<10} {fp(key) if key else '(no key yet)'}  {key.split()[-1] if key else ''}")
print(f"Retired login keys: {len(d['retired'])}")
for key in d["retired"]:
    print(f"  {fp(key)}")
PY
}

# The servers, by name, from the hosts.yaml the playbook reads.
server_names() {
  py - "$REPO/home/.chezmoidata/hosts.yaml" <<'PY'
import sys, yaml
print(" ".join(yaml.safe_load(open(sys.argv[1]))["hosts"]))
PY
}

# One server: only the playbook's checks and its users role, with that
# server's own sudo password.
push_server() {
  say "$1: its sudo password, then the playbook's checks and users role"
  (cd "$REPO/ansible" && uv run --quiet ansible-playbook site.yml -e target="$1" --tags users -e "@$2" -K)
}

# The mini: its authorized_keys from the login key and these device keys. A
# list, since chezmoi merges a map into the mini's own and replaces a list, so
# a device just taken away can't stay.
push_mini() {
  py - "$1" > "$tmp/mini.json" <<'PY' || return 1
import json, sys
d = json.load(open(sys.argv[1]))["device_keys"]
print(json.dumps({"ssh": {"authorizedDevices": [k for _, k in sorted(d.items()) if k]}}))
PY
  say "$MINI: its authorized_keys"
  # --force: that file is the repo's whole, so a hand edit there doesn't count.
  ssh "$MINI" 'f=$(mktemp -d)/devices.json && cat > "$f" && /opt/homebrew/bin/chezmoi apply --force --override-data-file "$f" ~/.ssh/authorized_keys; rc=$?; rm -rf "$(dirname "$f")"; exit $rc' < "$tmp/mini.json"
}

# push_keys <json> [name...]: the device keys and retired keys in json to each
# named server and the mini, or to all of them. Says which didn't take them.
push_keys() {
  local json=$1 name failed="" targets
  shift
  if [ ! -d "$REPO/ansible/collections/ansible_collections/devsec" ]; then
    warn "the playbook's collections aren't installed (cd $REPO/ansible && uv run --locked ansible-galaxy collection install -r requirements.yml)"
    return 1
  fi
  # Never an empty array: bash 3.2 under set -u calls that unbound.
  if [ $# -eq 0 ]; then
    read -ra targets <<< "$(server_names) $MINI"
  else
    targets=("$@")
  fi
  for name in "${targets[@]}"; do
    if [ "$name" = "$MINI" ]; then
      push_mini "$json" || failed="$failed $name"
    else
      push_server "$name" "$json" || failed="$failed $name"
    fi
  done
  if [ -n "$failed" ]; then
    warn "these didn't take the keys:$failed. Once each answers and any draft PR has merged: dotfiles device push$failed"
    return 1
  fi
  say "${targets[*]} have the keys"
}

# Records the change in the repo: a patch of keys.yaml, sent to the mini, where
# dotfiles adopt makes it a commit on its own branch and a draft PR.
record_change() {
  local subject=$1 body=$2 branch=$3 r="$tmp/record"
  git init -q "$r" && mkdir -p "$r/home/.chezmoidata" || return 1
  cp "$tmp/keys.yaml" "$r/home/.chezmoidata/keys.yaml"
  git -C "$r" add -A && git -C "$r" -c commit.gpgsign=false commit -q -m base || return 1
  cp "$tmp/keys.new" "$r/home/.chezmoidata/keys.yaml"
  git -C "$r" -c commit.gpgsign=false commit -q -a -m "$subject" -m "$body" || return 1
  git -C "$r" format-patch -q -1 --stdout > "$tmp/$branch.patch" || return 1
  say "recording it: a draft PR from the mini"
  # ssh starts each command in the mini's home folder, so the paths are from there.
  ssh "$MINI" 'mkdir -p agent-drafts/dotfiles' \
    && scp -q "$tmp/$branch.patch" "$MINI:agent-drafts/dotfiles/$branch.patch" \
    && ssh -t "$MINI" ".local/bin/dotfiles adopt agent-drafts/dotfiles/$branch.patch"
}

device_change() {
  local action=$1 name=$2 key=${3:-} old subject body branch
  pending_change && return 1
  fetch_keys || return 1
  keys_py "$tmp/keys.yaml" show > "$tmp/show.json" || return 1
  old=$(py -c 'import json, sys; print(json.load(open(sys.argv[1]))["devices"].get(sys.argv[2]) or "")' "$tmp/show.json" "$name")

  if [ "$action" = set ]; then
    check_key "$key" || return 1
    if [ -n "$old" ] && [ "$(body_of "$old")" = "$(body_of "$key")" ]; then
      say "$name already has that key; nothing to do"
      return 0
    fi
    local login others
    login=$(sed -n '/^  login:/,/^  [a-z]/s/^    public: "\(.*\)"$/\1/p' "$tmp/keys.yaml")
    others=$(py -c '
import json, sys
d = json.load(open(sys.argv[1]))
print("\n".join([k for n, k in d["devices"].items() if n != sys.argv[2] and k] + d["retired"]))' "$tmp/show.json" "$name")
    if [ "$(body_of "$key")" = "$(body_of "$login")" ] || grep -qF "$(body_of "$key")" <<< "$others"; then
      warn "that key is already the login key, another device's, or retired; each device has its own"
      return 1
    fi
  fi
  # Every refusal comes before the question: the edit writes only to $tmp.
  keys_py "$tmp/keys.yaml" "$action" "$name" "$key" || return 1

  if [ "$action" = set ]; then
    printf '\n%s gets the key %s\n' "$name" "$(fingerprint "$key")"
    [ -n "$old" ] && printf 'Its old key, %s, is retired: taken out everywhere\n' "$(fingerprint "$old")"
    subject="Give the $name a new key"
    [ -z "$old" ] && subject="Add the $name's key"
  else
    printf '\n%s goes' "$name"
    [ -n "$old" ] && printf ', and its key, %s, is taken out everywhere' "$(fingerprint "$old")"
    printf '\n'
    subject="Take the $name and its key away"
  fi
  printf 'This pushes the change to every server, each with its own sudo password,\nand the mini now, then opens a draft PR on the mini that records it. Merge\nthat PR before the next device change.\n\n'
  ask "Go ahead?" || { say "nothing changed"; return 1; }

  body="dotfiles device $action on $(hostname -s), $(date '+%Y-%m-%d %H:%M')."
  branch="device-$name-$(date +%Y%m%d-%H%M%S)"
  local rc=0
  push_keys "$tmp/keys.json" || rc=1
  record_change "$subject" "$body" "$branch" || { warn "the PR wasn't opened, so GitHub's keys.yaml doesn't have this change yet"; rc=1; }
  [ "$rc" = 0 ] && say "done. Merge the PR, then run dotfiles update"
  # Until that PR merges, an apply on the mini would put back its last keys.
  return "$rc"
}

cmd_device() {
  local sub=${1:-list}
  [ $# -gt 0 ] && shift
  case "$sub" in set | remove)
    case "${1:-}" in
      [a-z]*) ;;
      *) warn "a device's name starts with a letter"; return 2 ;;
    esac
    case "$1" in
      *[!a-z0-9-]*) warn "a device's name is lowercase letters, digits and hyphens, as iphone or ipad"; return 2 ;;
    esac ;;
  esac
  case "$sub" in
    list) device_list ;;
    set)
      [ $# -ge 1 ] || { usage; return 2; }
      # The key may come in words, unquoted, after the name.
      local name=$1 key
      shift
      key="$*"
      if [ -z "$key" ]; then
        key=$(pbpaste 2>/dev/null)
        say "the key from the clipboard"
      fi
      key=$(printf '%s' "$key" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      device_change set "$name" "$key"
      ;;
    remove)
      [ $# -eq 1 ] || { usage; return 2; }
      device_change remove "$1"
      ;;
    push)
      local known name
      known=" $(server_names) $MINI "
      for name in "$@"; do
        case "$known" in *" $name "*) ;; *) warn "$name is neither a server in hosts.yaml nor the mini"; return 2 ;; esac
      done
      pending_change && return 1
      fetch_keys || return 1
      keys_py "$tmp/keys.yaml" show > "$tmp/show.json" || return 1
      py - "$tmp/show.json" > "$tmp/keys.json" <<'PY' || return 1
import json, sys
d = json.load(open(sys.argv[1]))
print(json.dumps({"device_keys": d["devices"], "retired_login_keys": d["retired"]}))
PY
      ask "Push GitHub's device keys to ${*:-every server and the mini}?" || return 1
      push_keys "$tmp/keys.json" "$@"
      ;;
    *) usage; return 2 ;;
  esac
}
{{- end }}

{{- if .isAgent }}

###############################################################################
# adopt                                                                       #
###############################################################################

# Turns a patch the laptop sent into a commit on its own branch, in a worktree
# outside Dropbox as every change to this repo is made here, and a draft PR.
cmd_adopt() {
  local patch=${1:-} branch wt url
  [ -f "$patch" ] || { usage; return 2; }
  branch=$(basename "$patch" .patch)
  case "$branch" in *[!A-Za-z0-9._-]*) warn "\"$branch\" can't be a branch name"; return 1 ;; esac
  printf '\n%s\n' "$(sed -n 's/^Subject: \(\[PATCH\] \)\{0,1\}//p' "$patch" | head -1)"
  git apply --stat "$patch" 2>/dev/null || { warn "$patch isn't a patch git can read"; return 1; }
  printf '\n'
  ask "Commit this on a branch $branch and open a draft PR?" || { say "nothing changed"; return 1; }
  git -C "$REPO" fetch --quiet origin || { warn "couldn't fetch the repo"; return 1; }
  wt="$HOME/worktrees/dotfiles/$branch"
  [ -e "$wt" ] && { warn "$wt exists already"; return 1; }
  git -C "$REPO" worktree add --quiet --no-track -b "$branch" "$wt" origin/HEAD || return 1
  if ! git -C "$wt" am --quiet --3way "$patch"; then
    git -C "$wt" am --abort 2>/dev/null
    warn "the change doesn't apply to the repo as it is now; the worktree $wt is left for a look"
    return 1
  fi
  git -C "$wt" push --quiet -u origin "$branch" || { warn "the push failed; the commit is in $wt"; return 1; }
  if url=$(cd "$wt" && gh pr create --draft --fill 2>&1); then
    say "draft PR: $url"
    rm -f "$patch"
  else
    warn "the branch is pushed, but no PR: $url"
    return 1
  fi
}
{{- end }}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  update) cmd_update "$@" ;;
  doctor) cmd_doctor "$@" ;;
{{- if eq .role "laptop" }}
  device) cmd_device "$@" ;;
{{- end }}
{{- if .isAgent }}
  adopt) cmd_adopt "$@" ;;
{{- end }}
  "" | help | -h | --help) usage ;;
  *) usage; exit 2 ;;
esac
{{ end -}}

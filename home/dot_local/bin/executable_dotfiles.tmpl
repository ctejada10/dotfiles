#!/bin/bash
#
# dotfiles: this Mac's way into the dotfiles repo. With no argument it lists
# the commands this Mac has.
#
# Every question is asked on the terminal itself (/dev/tty), so nothing can
# answer for you. Started without a terminal, as the mini's agents start
# commands, a command that changes anything stops before it does.

set -uo pipefail
SCRIPT=dotfiles
{{ template "script-lib.sh" . }}

ROLE={{ .role | squote }}
REPO=${DOTFILES_REPO:-{{ .chezmoi.workingTree | squote }}}
{{- if eq .role "laptop" }}
MINI={{ $mini | squote }}
{{- end }}

usage() {
  cat <<'EOF'
Usage:
  dotfiles update          pull the repo, show what an apply would change, then apply
  dotfiles doctor          check this Mac against the repo; only reads
{{- if eq .role "laptop" }}
  dotfiles doctor --keys   the same, plus SSH to GitHub and a signed commit,
                           which 1Password approves
  dotfiles device          list the phones' and tablets' keys
  dotfiles device set <name> [<public key>]
                           add a device's key, or replace it; the key comes
                           from the clipboard when it isn't given
  dotfiles device remove <name>
                           take a device and its key away
  dotfiles device push [<server or mini>...]
                           push GitHub's copy of the device keys again, to
                           every server and the mini or to those named
{{- end }}
{{- if .isAgent }}
  dotfiles adopt <patch>   turn a change the laptop sent into a draft PR
{{- end }}
EOF
}

# Whether there's a terminal to ask on. Opening /dev/tty fails without one.
have_terminal() { { exec 3</dev/tty; } 2>/dev/null && exec 3<&-; }

# ask <question>: y on the terminal is yes; anything else, or no terminal, no.
ask() {
  local reply=
  if ! { exec 3</dev/tty; } 2>/dev/null; then
    warn "$1: there's no terminal to answer on, so no"
    return 1
  fi
  printf '%s [y/N] ' "$1" >/dev/tty
  IFS= read -r reply <&3 || reply=
  exec 3<&-
  case "$reply" in y | Y | yes) return 0 ;; *) return 1 ;; esac
}

# The temporary folder is the only thing this makes, and mktemp -d makes it
# 0700; everything else runs under the caller's umask, as a plain apply does.
tmp=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
# Ctrl-C stops here too. ansible-playbook and uv catch it and exit normally,
# which bash would otherwise take as a reason to go on to the next step.
trap 'exit 130' INT

settings_template="$REPO/home/.chezmoiscripts/run_after_30-macos-settings.sh.tmpl"

# The macOS settings script in its dry-run mode, which only reads.
settings_dry_run() {
  chezmoi execute-template < "$settings_template" > "$tmp/settings.sh" 2>"$tmp/settings.err" \
    || { cat "$tmp/settings.err"; return 1; }
  DOTFILES_CHECK=1 bash "$tmp/settings.sh"
}

# The dry run's verdict, in SETTINGS_STATE: ok when nothing would change, skip
# or fail; changes when something would; unknown when the script didn't render
# or stopped before its summary. SETTINGS_OUT holds what it printed.
SETTINGS_STATE=unknown SETTINGS_OUT=
settings_verdict() {
  local summary would skipped failed
  SETTINGS_STATE=unknown
  SETTINGS_OUT=$(settings_dry_run 2>&1) || return 0
  summary=$(grep 'dry run: [0-9][0-9]* would change' <<< "$SETTINGS_OUT" | tail -1)
  [ -n "$summary" ] || return 0
  would=$(sed -n 's/.*dry run: \([0-9][0-9]*\) would change.*/\1/p' <<< "$summary")
  skipped=$(sed -n 's/.* \([0-9][0-9]*\) skipped.*/\1/p' <<< "$summary")
  failed=$(sed -n 's/.* \([0-9][0-9]*\) failed.*/\1/p' <<< "$summary")
  if [ "$would" = 0 ] && [ "${skipped:-0}" = 0 ] && [ "${failed:-0}" = 0 ]; then
    SETTINGS_STATE=ok
  else
    SETTINGS_STATE=changes
  fi
}
# What the dry run said besides its summary: each would-be change and warning.
settings_lines() { grep -v 'dry run: [0-9]' <<< "$SETTINGS_OUT"; }

brewfile_check() {
  HOMEBREW_TILDE_ROLE=$ROLE HOMEBREW_NO_AUTO_UPDATE=1 \
    brew bundle check --no-upgrade --verbose --file="$REPO/Brewfile"
}

###############################################################################
# update                                                                      #
###############################################################################

cmd_update() {
  if ! have_terminal; then
    warn "update needs a terminal to answer on; nothing was pulled or applied"
    return 1
  fi
  say "pulling the repo"
  # Fast-forward only: a checkout with edits or commits of its own is left as
  # it is, rather than stashed, rebased or merged into something with conflict
  # markers that an apply would then write out.
  if ! git -C "$REPO" pull --quiet --ff-only --no-rebase --no-autostash; then
    warn "the pull didn't fast-forward: put the checkout's own changes in $REPO aside, then run this again. Nothing was applied"
    return 1
  fi
  if [ -n "$(git -C "$REPO" ls-files -u)" ]; then
    warn "$REPO has unresolved conflicts; nothing was applied"
    return 1
  fi
  local files packages
  files=$(chezmoi diff --no-pager 2>&1)
  settings_verdict
  if packages=$(brewfile_check 2>&1); then
    packages=
  else
    [ -n "$packages" ] || packages="brew bundle check found something missing"
  fi

  if [ -z "$files" ] && [ "$SETTINGS_STATE" = ok ] && [ -z "$packages" ]; then
    say "files, settings and packages already match the repo"
  else
    [ -n "$files" ] && printf '\nFiles:\n%s\n' "$files"
    case "$SETTINGS_STATE" in
      changes) printf '\nSettings:\n%s\n' "$(settings_lines)" ;;
      unknown) printf "\nSettings: the dry run didn't finish, so what an apply would change there is unknown:\n%s\n" "$SETTINGS_OUT" ;;
    esac
    [ -n "$packages" ] && printf '\nPackages:\n%s\n' "$packages"
    printf '\n'
  fi
  # The setup scripts run on every apply too, so there may be work even when
  # nothing above changes.
  if ask "Apply now?"; then
    chezmoi apply
  else
    say "nothing applied"
  fi
}

###############################################################################
# doctor                                                                      #
###############################################################################

PASSED=0 FAILED=0 SKIPPED=0
ok()   { printf '  ok    %s\n' "$1"; PASSED=$((PASSED + 1)); }
bad()  { printf '  FAIL  %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; FAILED=$((FAILED + 1)); }
skip() { printf '  skip  %s: %s\n' "$1" "$2"; SKIPPED=$((SKIPPED + 1)); }
check() { local name=$1; shift; if "$@" >/dev/null 2>&1; then ok "$name"; else bad "$name"; fi; }

listening() { nc -z -G 2 127.0.0.1 "$1" >/dev/null 2>&1; }

# The repo's GitHub address over HTTPS, whatever the checkout's remote says.
github_https() {
  local url
  url=$(git -C "$REPO" remote get-url origin 2>/dev/null) || return 1
  url=${url%.git}
  url=${url#git@github.com:}
  url=${url#https://github.com/}
  printf 'https://github.com/%s\n' "$url"
}

doctor_common() {
  local out version marker
  printf 'This Mac against the repo\n'
  check "chezmoi verify: every file matches" chezmoi verify
  settings_verdict
  case "$SETTINGS_STATE" in
    ok) ok "every macOS setting matches" ;;
    changes) bad "every macOS setting matches" "$(settings_lines | head -5)" ;;
    *) bad "every macOS setting matches" "the dry run didn't finish: $(tail -1 <<< "$SETTINGS_OUT")" ;;
  esac
  if out=$(brewfile_check 2>&1); then ok "every package in the Brewfile is installed"
  else bad "every package in the Brewfile is installed" "$(head -3 <<< "$out")"; fi
  version={{ .fonts.monolisa.version | squote }}
  marker=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/fonts/monolisa.version" 2>/dev/null)
  if [ "$marker" = "$version" ] && ls "$HOME/Library/Fonts"/MonoLisa* >/dev/null 2>&1; then
    ok "MonoLisa $version is installed"
  else
    bad "MonoLisa $version is installed" "the next apply at the Mac's own screen fetches it from 1Password"
  fi

  printf '\nAccounts and network\n'
  # The login this Mac uses, not every account gh holds.
  check "gh is signed in" timeout_run 20 gh auth status --active --hostname github.com
  check "GitHub answers for the dotfiles repo" timeout_run 20 env GIT_TERMINAL_PROMPT=0 git ls-remote "$(github_https)" HEAD
  check "Tailscale is connected" timeout_run 10 /Applications/Tailscale.app/Contents/MacOS/Tailscale status
}

{{- if .isAgent }}

# RFB's security types from the Screen Sharing server: 2 is VNC Authentication,
# the password-only one (RFC 6143, 7.1.2).
vnc_types() {
  perl -MIO::Socket::INET -e '
    my $s = IO::Socket::INET->new(PeerAddr => "127.0.0.1", PeerPort => 5900, Timeout => 3) or exit 2;
    $s->sysread(my $v, 12) == 12 or exit 3;
    $s->syswrite("RFB 003.008\n");
    $s->sysread(my $n, 1) == 1 or exit 4;
    $n = ord $n; $n or exit 5;
    $s->sysread(my $t, $n) == $n or exit 6;
    print join(" ", unpack("C*", $t)), "\n";
  '
}

# Any answer to an SSDP search for an Internet gateway, the request UPnP's port
# forwarding starts with: exits 0 with the answer, 1 on silence, 2 when the
# search couldn't be sent. The socket isn't connected: a router answers from
# its own address, which a socket connected to the multicast group would drop.
upnp_answer() {
  perl -MIO::Socket::INET -MSocket -e '
    my $s = IO::Socket::INET->new(Proto => "udp", LocalPort => 0) or exit 2;
    my $to = sockaddr_in(1900, inet_aton("239.255.255.250"));
    $s->send(join("\r\n", "M-SEARCH * HTTP/1.1", "HOST: 239.255.255.250:1900",
      "MAN: \"ssdp:discover\"", "MX: 2",
      "ST: urn:schemas-upnp-org:device:InternetGatewayDevice:1", "", ""), 0, $to) or exit 2;
    my $rin = ""; vec($rin, fileno($s), 1) = 1;
    exit 1 unless select(my $rout = $rin, undef, undef, 3);
    $s->recv(my $buf, 1500); print "$buf\n";
  '
}

# T3 Code's two settings the mini needs, answered yes or no only: the file
# also holds the instances' environment, so nothing else from it is printed.
t3_setting() {
  /usr/bin/python3 -I - "$HOME/.t3/userdata/settings.json" "$1" <<'PY'
import json, sys
path, which = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(path))
except Exception:
    print("unreadable"); sys.exit(0)
def walk(node, keys=()):
    if isinstance(node, dict):
        for k, v in node.items():
            yield from walk(v, keys + (str(k),))
    elif isinstance(node, list):
        for v in node:
            yield from walk(v, keys)
    else:
        yield keys, node
found = False
for keys, value in walk(data):
    path_text = " ".join(keys).lower()
    if which == "attended" and value == "Claude (attended)":
        found = True
    if which == "cleanup" and value is True and "worktree" in path_text and ("cleanup" in path_text or "merge" in path_text):
        found = True
print("yes" if found else "no")
PY
}

doctor_mini() {
  local out node want signing offers rc fw=/usr/libexec/ApplicationFirewall/socketfilterfw
  printf '\nThe mini\n'
  check "GitHub answers for cad-a11y through gh" timeout_run 20 env GIT_TERMINAL_PROMPT=0 git ls-remote https://github.com/cad-accessibility/cad-a11y HEAD
  [ "$(readlink /etc/localtime)" = /var/db/timezone/zoneinfo/America/New_York ] \
    && ok "the time zone is America/New_York" || bad "the time zone is America/New_York" "$(readlink /etc/localtime)"
  node=$(node --version 2>/dev/null | sed 's/^v\([0-9]*\).*/\1/')
  [ "${node:-0}" -ge 20 ] 2>/dev/null && ok "node is v20 or later" || bad "node is v20 or later" "${node:-not found}"
  check "Claude Code is installed" claude --version
  check "Git LFS is installed" git lfs version
  local missing="" repo
  for repo in {{ index .repos "agent-mini" | keys | sortAlpha | join " " }}; do
    [ -d "$HOME/src/$repo/.git" ] || missing="$missing $repo"
  done
  [ -z "$missing" ] && ok "every repo the agents work in is in ~/src" \
    || bad "every repo the agents work in is in ~/src" "missing:$missing (the next apply clones them once Dropbox has synced)"
  # Off now and not set to turn on at the next restart, which would stop the
  # automatic login.
  out=$(fdesetup status 2>&1)
  if [ "$(head -1 <<< "$out")" = 'FileVault is Off.' ] && ! grep -qi 'deferred' <<< "$out"; then
    ok "FileVault is off, so a restart logs in by itself"
  else
    bad "FileVault is off, so a restart logs in by itself" "$out"
  fi
  [ "$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)" = "$USER" ] \
    && ok "automatic login is on for $USER" || bad "automatic login is on for $USER" "General > Users & Groups"
  if listening 22; then
    ok "Remote Login answers"
    # The sshd that answers, not the file: a client with no key must be offered
    # publickey and nothing else. It needs no root.
    offers=$(SSH_AUTH_SOCK='' ssh -F /dev/null -o BatchMode=yes -o PubkeyAuthentication=no \
               -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
               -o ConnectTimeout=5 "$USER@127.0.0.1" true 2>&1 \
             | sed -n 's/.*Permission denied (\(.*\))\..*/\1/p')
    [ "$offers" = publickey ] && ok "SSH takes keys only" \
      || bad "SSH takes keys only" "it offers ${offers:-something unexpected} to a client with no key"
  else
    bad "Remote Login answers" "General > Sharing"
  fi
  if listening 5900; then
    ok "Screen Sharing answers"
    if out=$(vnc_types); then
      case " $out " in
        *" 2 "*) bad "Screen Sharing offers no password-only (VNC) login" "turn off \"VNC viewers may control screen with password\"" ;;
        *) ok "Screen Sharing offers no password-only (VNC) login" ;;
      esac
    else
      skip "Screen Sharing offers no password-only (VNC) login" "couldn't read its security types"
    fi
  else
    bad "Screen Sharing answers" "General > Sharing"
  fi
  # As the settings script counts them: on is state 1 or 2, and block-all,
  # which shuts out SSH and Screen Sharing, is a check of its own.
  "$fw" --getglobalstate 2>/dev/null | grep -q 'State = [12]' && ok "the firewall is on" || bad "the firewall is on"
  "$fw" --getblockall 2>/dev/null | grep -q 'disabled' && ok "the firewall's block-all is off" \
    || bad "the firewall's block-all is off" "it shuts out SSH and Screen Sharing; the next apply turns it off"
  "$fw" --getstealthmode 2>/dev/null | grep -qi 'on' && ok "stealth mode is on" || bad "stealth mode is on"
  check "the worktree cleanup job is loaded" launchctl print "gui/$(id -u)/com.carlosetejada.worktree-ttl"
  if [ -f "$HOME/.t3/userdata/settings.json" ]; then
    [ "$(t3_setting attended)" = yes ] && ok "T3 has the \"Claude (attended)\" instance" \
      || bad "T3 has the \"Claude (attended)\" instance" "Settings > Providers (README, The mini)"
    [ "$(t3_setting cleanup)" = yes ] && ok "T3 removes a worktree once its PR merges" \
      || bad "T3 removes a worktree once its PR merges" "Settings: Automatic worktree cleanup on merge"
  else
    skip "T3's settings" "T3 hasn't run on this Mac yet"
  fi
  out=$(upnp_answer); rc=$?
  case "$rc" in
    0) bad "no router here answers UPnP" "$(head -1 <<< "$out")" ;;
    1) ok "no router here answers UPnP" ;;
    *) skip "no router here answers UPnP" "couldn't send the search" ;;
  esac
  if timeout_run 20 gh auth status --active --hostname github.com 2>&1 | grep -q 'ssh_signing_key'; then
    want=$(awk '{print $2}' "$HOME/.ssh/mini_signing.pub" 2>/dev/null)
    signing=$(timeout_run 20 gh api user/ssh_signing_keys --jq '.[].key' 2>/dev/null)
    [ -n "$want" ] && grep -qF "$want" <<< "$signing" && ok "GitHub has the mini's signing key" \
      || bad "GitHub has the mini's signing key" "README, The mini: gh ssh-key add --type signing"
  else
    skip "GitHub has the mini's signing key" "gh's login lacks the read:ssh_signing_key scope"
  fi
}
{{- end }}

{{- if eq .role "laptop" }}

# The two checks that use the login and signing keys, which 1Password approves.
doctor_keys() {
  local out t
  printf '\nThe keys in 1Password\n'
  out=$(timeout_run 60 ssh -T git@github.com 2>&1)
  grep -q 'successfully authenticated' <<< "$out" && ok "GitHub takes the login key" || bad "GitHub takes the login key" "$out"
  t="$tmp/signed"
  if git init -q "$t" && git -C "$t" commit -q --allow-empty -S -m signed 2>/dev/null \
    && [ "$(git -C "$t" log -1 --format=%G?)" = G ]; then
    ok "a commit is signed with the signing key"
  else
    bad "a commit is signed with the signing key" "$(git -C "$t" log -1 --format='%G? %GS' 2>&1)"
  fi
}
{{- end }}

cmd_doctor() {
  doctor_common
{{- if .isAgent }}
  doctor_mini
{{- end }}
{{- if eq .role "laptop" }}
  [ "${1:-}" = --keys ] && doctor_keys
{{- end }}
  printf '\n%s ok, %s failed, %s skipped\n' "$PASSED" "$FAILED" "$SKIPPED"
  [ "$FAILED" = 0 ]
}


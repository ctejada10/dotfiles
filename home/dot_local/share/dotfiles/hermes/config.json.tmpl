{{- $h := .hermes -}}
{{- $desired := dict
  "approvals.mode" "smart"
  "approvals.cron_mode" "deny"
  "approvals.deny" (list
    "*gmail send*" "*gmail reply*" "*gmail modify*" "*messages send*"
    "*drafts send*" "*calendar delete*" "*.obsidian*" "git push --force*"
    "*rm -rf*" "*rm -fr*" "*rm -r *" "*rm --recursive*"
    "*git push*" "*curl *" "*wget *"
    "*.hermes/hermes-agent*" "*launchctl*")
  "terminal.backend" "local"
  "skills.write_approval" true
  "memory.write_approval" true
  "web.keyless_fallback" false
  "web.keyless_rescue" false
  "tools.connectors.enabled" false
  "cron.model" $h.cronModel
  "cron.model_provider" $h.cronProvider
-}}
{{- /* Hermes has one webhook listener; each enabled block adds its route. A
       route with no telegramChatId has no deliver_extra, so Hermes uses the
       home channel: it renders an empty chat_id as the whole event. */ -}}
{{- $routes := dict -}}
{{- $listen := dict -}}
{{- if $h.hurin.enabled -}}
{{-   $base := printf "http://%s:%v/mcp" $h.hurin.host $h.hurin.port -}}
{{-   $route := dict
        "secret" "${HURIN_WEBHOOK_SECRET}"
        "skills" (list "hurin-events")
        "prompt" "{__raw__}"
        "deliver" "telegram"
        "mirror_to_session" true
-}}
{{-   if $h.hurin.telegramChatId -}}
{{-     $_ := set $route "deliver_extra" (dict "chat_id" $h.hurin.telegramChatId) -}}
{{-   end -}}
{{-   $_ := set $desired "command_allowlist" (list
        "mcp:hurin_act/event_reply"
        "mcp:hurin_act/commitment_record"
        "mcp:hurin_act/roll_loaded"
        "mcp:hurin_act/roll_finished"
        "mcp:hurin_act/github_issue_open_or_comment") -}}
{{-   $_ := set $desired "mcp_servers.hurin_read" (dict
        "url" (printf "%s/read" $base)
        "headers" (dict "Authorization" "Bearer ${HURIN_MCP_READ_TOKEN}")
        "trust" "full") -}}
{{-   $_ := set $desired "mcp_servers.hurin_act" (dict
        "url" (printf "%s/act" $base)
        "headers" (dict "Authorization" "Bearer ${HURIN_MCP_ACT_TOKEN}")
        "trust" "untrusted") -}}
{{-   $_ := set $routes "hurin" $route -}}
{{-   $listen = dict "host" $h.hurin.webhookHost "port" $h.hurin.webhookPort -}}
{{- else -}}
{{-   $_ := set $desired "command_allowlist" (list) -}}
{{- end -}}
{{- if $h.rivendell.enabled -}}
{{-   if not $h.rivendell.webhookHost -}}
{{-     fail "hermes.rivendell.webhookHost must be this Mac's tailnet address, or Hermes's webhook listener binds every interface" -}}
{{-   end -}}
{{-   $at := dict "host" $h.rivendell.webhookHost "port" $h.rivendell.webhookPort -}}
{{-   if and $listen (ne (toJson $listen) (toJson $at)) -}}
{{-     fail "hermes.hurin and hermes.rivendell must name the same webhookHost and webhookPort: Hermes has one webhook listener" -}}
{{-   end -}}
{{-   $listen = $at -}}
{{-   $route := dict
        "secret" "${RIVENDELL_WEBHOOK_SECRET}"
        "skills" (list "rivendell-events")
        "prompt" "{__raw__}"
        "deliver" "telegram"
        "mirror_to_session" true
-}}
{{-   if $h.rivendell.telegramChatId -}}
{{-     $_ := set $route "deliver_extra" (dict "chat_id" $h.rivendell.telegramChatId) -}}
{{-   end -}}
{{-   $_ := set $routes "rivendell" $route -}}
{{- /* The relay's state snapshots. Its script stores each one and answers
         [SILENT], so Hermes starts no agent run and delivers nothing. */ -}}
{{-   $_ := set $routes "rivendell-state" (dict
        "secret" "${RIVENDELL_WEBHOOK_SECRET}"
        "script" "rivendell-state.py") -}}
{{- end -}}
{{- if $routes -}}
{{-   $_ := set $desired "platforms.webhook" (dict
        "enabled" true
        "extra" (dict "host" $listen.host "port" $listen.port "routes" $routes)) -}}
{{- end -}}
{{ toPrettyJson $desired }}

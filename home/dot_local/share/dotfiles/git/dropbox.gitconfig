# Included on both Macs for any repo still in Dropbox's repositories folder,
# the repos' old home. Git's automatic gc and background maintenance repack and
# prune the object store, and doing that in a folder Dropbox is syncing is how
# one was destroyed. If a repo ever needs compacting, pause Dropbox and do it
# by hand.

[gc]
	auto = 0
	# Nor a manual gc pruning the records of worktrees another Mac made.
	worktreePruneExpire = never

[maintenance]
	auto = false

# Nothing Git only caches goes into a .git Dropbox syncs: no fsmonitor daemon,
# whose socket and cookie files churn, and no untracked cache.
[core]
	fsmonitor = false
	untrackedCache = false

{{- /* The mini's agents read one shared rules file, ~/.codex/AGENTS.md,
       which replaces every rules file here. Elsewhere there is no Codex. */}}
{{ if .isAgent -}}
.claude/rules
{{- else -}}
.codex
{{- end }}

{{- /* Files written into Dropbox wait until Dropbox has brought the folder
       down; a folder created here first would fight Dropbox's own. So does
       the ~/.config link: made earlier, it would point at nothing and take
       chezmoi's own config and state with the folder it replaced. */}}
{{ if not (and (hasKey . "dropboxConfig") (stat .dropboxConfig)) -}}
Library/CloudStorage/Dropbox
.config
{{- end }}

{{ if not .isAgent -}}
agent-drafts
{{- end }}

{{- /* authorized_keys is written only once the laptop's login key exists:
       an empty template would delete whatever the file holds now. */}}
{{ if or (not .isAgent) (not .ssh.login.public) -}}
.ssh/authorized_keys
{{- end }}

{{ if .isServer -}}
.ssh

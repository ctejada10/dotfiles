# Read by every zsh, interactive or not, including commands run over SSH and
# shells that launchd jobs start. Environment only.

source $HOME/.zsh/path.zsh
{{- if .isMac }}

export HOMEBREW_NO_AUTO_UPDATE=1
# The shared Brewfile picks its blocks from this, so `brew bundle` works by hand.
export HOMEBREW_TILDE_ROLE={{ .role }}
{{- end }}
{{- if .isAgent }}

# no-mistakes reads these from the login shell: no telemetry, and no update
# check, since its version is pinned in the dotfiles.
export NO_MISTAKES_TELEMETRY=0
export NO_MISTAKES_NO_UPDATE_CHECK=1

# OpenSCAD's libraries (BOSL2) live outside ~/Documents on the mini.
export OPENSCADPATH="$HOME/.local/share/openscad/libraries"

# FirstMate's state and projects. Its crews' worktrees go to treehouse's
# default, ~/.treehouse.
export FM_HOME="$HOME/{{ .firstmate.home }}"
{{- end }}

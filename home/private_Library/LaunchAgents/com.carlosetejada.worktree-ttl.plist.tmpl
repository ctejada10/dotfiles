{{- if .isAgent -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.carlosetejada.worktree-ttl</string>

	<!-- Removes the mini's own worktrees in ~/worktrees once they go 14 days
	     unused and nothing in them would be lost. It runs live from the start:
	     no worktree is older than the TTL during the first two weeks. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ .chezmoi.homeDir }}/.local/bin/worktree-ttl</string>
		<string>--ttl-days</string>
		<string>14</string>
	</array>

	<!-- Once a day. A run missed during sleep starts on wake; one missed
	     while the Mac was off waits for the next day. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>17</integer>
	</dict>

	<!-- The script also sets its own PATH, system tools first, and finds
	     git and gh in /opt/homebrew/bin by absolute path. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>{{ .chezmoi.homeDir }}</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
	</dict>

	<key>WorkingDirectory</key>
	<string>{{ .chezmoi.homeDir }}</string>

	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>

	<!-- The script writes its own log and attention file under
	     ~/Library/Logs/worktree-ttl/. -->
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/worktree-ttl.stderr.log</string>
</dict>
</plist>
{{ end -}}

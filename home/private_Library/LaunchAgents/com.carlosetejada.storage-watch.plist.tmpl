{{- if .isAgent -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.carlosetejada.storage-watch</string>

	<!-- Trims Colima's disk and build cache while Colima runs, and tells
	     Carlos when the disk is filling. It deletes nothing on the Mac. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ .chezmoi.homeDir }}/.local/bin/storage-watch</string>
	</array>

	<!-- Every 3 hours from when it was loaded. -->
	<key>StartInterval</key>
	<integer>10800</integer>

	<!-- The script also sets its own PATH, system tools first, with
	     colima and docker in /opt/homebrew/bin. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>{{ .chezmoi.homeDir }}</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
	</dict>

	<key>WorkingDirectory</key>
	<string>{{ .chezmoi.homeDir }}</string>

	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>

	<!-- The script writes its own log under ~/Library/Logs/storage-watch/. -->
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/storage-watch.stderr.log</string>
</dict>
</plist>
{{ end -}}

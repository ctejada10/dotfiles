alias vi=vim
alias svi='sudo vim'

alias whereami='uname -n'

alias docker-stop-all='docker stop $(docker ps -aq)'
alias docker-rmi-all='docker rmi $(docker images -q)'
alias docker-rm-all='docker rm $(docker ps -aq)'
{{- if not .isMac }}

alias update='sudo apt -y update; sudo apt -y upgrade; sudo apt autoremove; sudo apt autoclean'
{{- end }}

alias grep='grep --color=auto'

alias mkdir='mkdir -p'

# Tools, only where they're installed, so a missing one never breaks a basic
# command. Ubuntu installs bat as batcat.
if (( $+commands[eza] )); then
  alias ls="eza"
  alias ll="eza -lh --icons"
  alias lla="eza -alh --icons"
  alias tree="eza --tree"
fi
{{- if not .isServer }}
if (( $+commands[bat] )); then
  alias cat="bat"
elif (( $+commands[batcat] )); then
  alias cat="batcat"
fi
{{- else }}
# No cat alias on servers: hand checks pasted from READMEs expect plain output.
{{- end }}

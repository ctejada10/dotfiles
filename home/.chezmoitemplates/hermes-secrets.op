# Rendered with op inject into a marked block in ~/.hermes/.env.
TELEGRAM_BOT_TOKEN=op://Hermes/Telegram/bot-token
TELEGRAM_ALLOWED_USERS=op://Hermes/Telegram/user-id
{{- if .hermes.hurin.enabled }}
HURIN_MCP_READ_TOKEN=op://Hermes/Hurin/mcp-read-token
HURIN_MCP_ACT_TOKEN=op://Hermes/Hurin/mcp-act-token
HURIN_WEBHOOK_SECRET=op://Hermes/Hurin/webhook-signing-secret
{{- end }}
